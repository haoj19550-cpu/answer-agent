# 模式开关：1=内置样例（无需 Key，联调/演示）；0=真实 DeepSeek
FAKE_LLM=0

DEEPSEEK_API_KEY=sk-your-deepseek-key
# 现役模型：deepseek-v4-flash（便宜快）/ deepseek-v4-pro（质量优先）
# 注意：deepseek-chat / deepseek-reasoner 两个旧名已于 2026-07-24 停用
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 结构化输出必须关闭思考模式（thinking 与强制 Schema 冲突）
DEEPSEEK_DISABLE_THINKING=1

# 备用模型（通义千问，百炼兼容端点），不配置则不装配回退
FALLBACK_API_KEY=
FALLBACK_MODEL=qwen-plus
FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 真实模型参数
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
CHAIN_MAX_ATTEMPTS=2
VALIDATE_RETRY_PER_STEP=1
# Grounded Quiz 严格度：1=source_excerpt 未命中原文即判失败（触发降级重生成）；0=仅告警
GROUNDED_STRICT=1

MONTHLY_QUOTA=30
